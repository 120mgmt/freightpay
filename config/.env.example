# LedgerHaul — Required Environment Variables
# Copy this file, rename to .env, and fill in your values
# NEVER commit .env to git

# ── App ────────────────────────────────────────
APP_ENV=production
BASE_URL=https://ledgerhaul.com
PORT=10000
LOG_LEVEL=INFO

# ── Security ───────────────────────────────────
SECRET_KEY=your-long-random-secret-key-min-32-chars
JWT_SECRET_KEY=your-long-random-jwt-secret-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=43200

# ── Database ───────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/ledgerhaul

# ── Stripe ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs
STRIPE_PRICE_COMBO_BASE=price_...
STRIPE_PRICE_COMBO_WORKER=price_...
STRIPE_PRICE_PAYROLL_BASE=price_...
STRIPE_PRICE_PAYROLL_WORKER=price_...
STRIPE_PRICE_BOOKKEEPING=price_...

# ── CORS ───────────────────────────────────────
CORS_ORIGINS=https://ledgerhaul.com,https://www.ledgerhaul.com

# ── Receipts ───────────────────────────────────
RECEIPTS_UPLOAD_DIR=/opt/render/project/uploads/receipts
RECEIPTS_MAX_MB=10

# ── Demo ───────────────────────────────────────
DEMO_ENABLED=0